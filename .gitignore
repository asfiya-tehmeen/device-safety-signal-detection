# Python / tooling
.venv/
__pycache__/
.pytest_cache/

# Working files and logs (logs contain nothing needed to reproduce)
logs/

# Large, reproducible data: rebuilt with `python src/ingest.py all` and `python src/build.py`
data/raw/**/*.gz
data/raw/**/*.split
data/raw/**/*.tmp
data/gold/

# Power BI: keep the .pbix, DAX docs, CSVs and PNG. The .pbip project folder has a machine-specific
# absolute path and local cache files, and it duplicates the .pbix.
reports/powerbi/DeviceWatch/
**/.pbi/

# Secrets: never commit keys
.env
*.key

# Personal notes, old plan versions and AI prompts (local only)
my_README*.md
NEXT_PROMPT.md
*_PROMPT.md
